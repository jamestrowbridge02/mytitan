{
  "name": "MyTitan",
  "short_name": "MyTitan",
  "description": "MyTitan helps service businesses run bookings, jobs, customers, approvals, scheduling, and billing in one place.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "theme_color": "#2563EB",
  "background_color": "#F3F6FB",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "categories": ["business", "productivity"],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard"
    },
    {
      "name": "Bookings",
      "short_name": "Bookings",
      "url": "/dashboard/bookings"
    }
  ]
}
