# MyTitan isolated validation environment template.
# Copy to .env.validation locally if you need overrides. Do not put real production secrets here.

MYTITAN_RUNTIME_ENV=validation
MYTITAN_ENV=validation

VALIDATION_POSTGRES_PASSWORD=validation_postgres_password_change_me
DATABASE_URL=postgresql://mytitan_validation:validation_postgres_password_change_me@validation_postgres:5432/mytitan_validation
REDIS_URL=redis://validation_redis:6379

VALIDATION_JWT_SECRET=validation_jwt_secret_change_me_32_chars
VALIDATION_INTEGRATIONS_ENCRYPTION_KEY=validation_integrations_key_change_me_32_chars
VALIDATION_BACKUP_ENCRYPTION_KEY=validation_backup_key_change_me_32_chars

APP_PUBLIC_URL=http://127.0.0.1:3101
API_PUBLIC_URL=http://127.0.0.1:3100
MARKETING_PUBLIC_URL=http://127.0.0.1:3102

UPLOAD_ROOT=/validation-media
MYTITAN_MEDIA_ROOT=/validation-media
MYTITAN_STORAGE_ROOT=/validation-media

MYTITAN_VALIDATION_SCHEDULER_ENABLED=0

MYTITAN_FEATURE_MARKETPLACE=on
MYTITAN_FEATURE_TRADE_PACKS=on
MYTITAN_FEATURE_START_HERE=on
MYTITAN_FEATURE_WHEELS_FORM_V1=on
