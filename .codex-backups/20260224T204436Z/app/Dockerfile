FROM node:20-bullseye-slim AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_MYTITAN_FEATURE_MARKETPLACE
ARG NEXT_PUBLIC_MYTITAN_FEATURE_TRADE_PACKS
ARG NEXT_PUBLIC_MYTITAN_FEATURE_START_HERE
ARG NEXT_PUBLIC_MYTITAN_FEATURE_WHEELS_FORM_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_PUBLIC_DEMO
ARG NEXT_PUBLIC_MYTITAN_FEATURE_COMMAND_CENTRE
ARG NEXT_PUBLIC_MYTITAN_FEATURE_CRM_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_DRAFTS_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_DEMO_TOUR_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_AUTH_POLISH_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_MARKETING_POLISH_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_COMMAND_CENTRE_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_LOCATIONS_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_INVENTORY_V1
ARG NEXT_PUBLIC_MYTITAN_FEATURE_LOGOUT_V1
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_MARKETPLACE=${NEXT_PUBLIC_MYTITAN_FEATURE_MARKETPLACE}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_TRADE_PACKS=${NEXT_PUBLIC_MYTITAN_FEATURE_TRADE_PACKS}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_START_HERE=${NEXT_PUBLIC_MYTITAN_FEATURE_START_HERE}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_WHEELS_FORM_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_WHEELS_FORM_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_PUBLIC_DEMO=${NEXT_PUBLIC_MYTITAN_FEATURE_PUBLIC_DEMO}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_COMMAND_CENTRE=${NEXT_PUBLIC_MYTITAN_FEATURE_COMMAND_CENTRE}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_CRM_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_CRM_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_DRAFTS_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_DRAFTS_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_DEMO_TOUR_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_DEMO_TOUR_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_AUTH_POLISH_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_AUTH_POLISH_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_MARKETING_POLISH_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_MARKETING_POLISH_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_COMMAND_CENTRE_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_COMMAND_CENTRE_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_LOCATIONS_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_LOCATIONS_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_INVENTORY_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_INVENTORY_V1}
ENV NEXT_PUBLIC_MYTITAN_FEATURE_LOGOUT_V1=${NEXT_PUBLIC_MYTITAN_FEATURE_LOGOUT_V1}
RUN mkdir -p public
RUN npm run build

FROM node:20-bullseye-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.js ./next.config.js

EXPOSE 3001
CMD ["npm", "run", "start", "--", "-p", "3001"]
