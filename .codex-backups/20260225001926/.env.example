# OpenAI (server-side only; never expose to browser)
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Stripe billing
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_PRICE_SOLE_TRADER_MONTHLY=price_123
STRIPE_PRICE_SOLE_TRADER_ANNUAL=price_124
STRIPE_PRICE_BUSINESS_MONTHLY=price_223
STRIPE_PRICE_BUSINESS_ANNUAL=price_224
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_323
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_324
STRIPE_BILLING_RETURN_URL=https://app.mytitan.co.uk/dashboard/billing

# Integrations encryption
INTEGRATIONS_ENCRYPTION_KEY=replace_with_32+_char_secret

# OAuth (placeholders)
XERO_CLIENT_ID=replace_with_xero_client_id
XERO_CLIENT_SECRET=replace_with_xero_client_secret
XERO_REDIRECT_URL=https://api.mytitan.co.uk/integrations/xero/callback
QBO_CLIENT_ID=replace_with_qbo_client_id
QBO_CLIENT_SECRET=replace_with_qbo_client_secret
QBO_REDIRECT_URL=https://api.mytitan.co.uk/integrations/qbo/callback
