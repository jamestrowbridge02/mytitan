# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Upload limits
TENANT_LOGO_MAX_BYTES=2097152

# Backups (host)
BACKUP_ENCRYPTION_KEY=replace_with_strong_passphrase
