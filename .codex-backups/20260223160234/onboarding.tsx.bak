import { useState } from 'react';
import { apiFetch } from '../lib/api';

type Step = 0 | 1 | 2 | 3 | 4 | 5;

export default function OnboardingPage() {
  const [step, setStep] = useState<Step>(0);
  const [status, setStatus] = useState('');
  const [error, setError] = useState('');

  const [branding, setBranding] = useState({
    logoUrl: '',
    brandPrimaryColor: '#4fd1c5',
    brandSecondaryColor: '#1a1f36',
    brandAccentColor: '#4fd1c5',
  });
  const [email, setEmail] = useState({ emailSenderName: '', emailReplyTo: '' });
  const [vat, setVat] = useState({ vatEnabledDefault: true, vatRateBpsDefault: 2000 });
  const [catalog, setCatalog] = useState({ name: '', unitPrice: '0', defaultQty: '1' });
  const [job, setJob] = useState({ customerName: '', vehicleReg: '' });
  const [invite, setInvite] = useState({ email: '', role: 'STAFF' });

  async function handleStep() {
    setError('');
    setStatus('');
    try {
      if (step === 0) {
        await apiFetch('/tenant/settings', { method: 'PUT', body: JSON.stringify(branding) });
      }
      if (step === 1) {
        await apiFetch('/tenant/settings', { method: 'PUT', body: JSON.stringify(email) });
      }
      if (step === 2) {
        await apiFetch('/tenant/settings', { method: 'PUT', body: JSON.stringify(vat) });
      }
      if (step === 3) {
        await apiFetch('/catalog/items', {
          method: 'POST',
          body: JSON.stringify({
            name: catalog.name,
            unitPrice: Number(catalog.unitPrice),
            defaultQty: Number(catalog.defaultQty),
            active: true,
          }),
        });
      }
      if (step === 4) {
        await apiFetch('/jobs', {
          method: 'POST',
          body: JSON.stringify({
            customerName: job.customerName,
            vehicleReg: job.vehicleReg || undefined,
          }),
        });
      }
      if (step === 5) {
        if (invite.email) {
          await apiFetch('/users/invite', {
            method: 'POST',
            body: JSON.stringify(invite),
          });
        }
        await apiFetch('/onboarding/complete', { method: 'POST' });
        window.location.href = '/dashboard';
        return;
      }

      setStatus('Saved.');
      setStep((prev) => (prev + 1) as Step);
    } catch (err: any) {
      setError(err.message || 'Failed to save step');
    }
  }

  return (
    <div className="container">
      <div className="card">
        <h1>Owner Onboarding</h1>
        <p className="muted">Complete the setup steps to launch your tenant.</p>

        {step === 0 && (
          <>
            <h3>Branding</h3>
            <label>Logo URL</label>
            <input className="input" value={branding.logoUrl} onChange={(e) => setBranding({ ...branding, logoUrl: e.target.value })} />
            <label>Primary colour</label>
            <input className="input" type="color" value={branding.brandPrimaryColor} onChange={(e) => setBranding({ ...branding, brandPrimaryColor: e.target.value })} />
            <label>Secondary colour</label>
            <input className="input" type="color" value={branding.brandSecondaryColor} onChange={(e) => setBranding({ ...branding, brandSecondaryColor: e.target.value })} />
            <label>Accent colour</label>
            <input className="input" type="color" value={branding.brandAccentColor} onChange={(e) => setBranding({ ...branding, brandAccentColor: e.target.value })} />
          </>
        )}

        {step === 1 && (
          <>
            <h3>Email Sender</h3>
            <label>Sender name</label>
            <input className="input" value={email.emailSenderName} onChange={(e) => setEmail({ ...email, emailSenderName: e.target.value })} />
            <label>Reply-to</label>
            <input className="input" value={email.emailReplyTo} onChange={(e) => setEmail({ ...email, emailReplyTo: e.target.value })} />
          </>
        )}

        {step === 2 && (
          <>
            <h3>VAT + Pricing</h3>
            <label>
              <input
                type="checkbox"
                checked={vat.vatEnabledDefault}
                onChange={(e) => setVat({ ...vat, vatEnabledDefault: e.target.checked })}
                style={{ marginRight: 8 }}
              />
              VAT enabled by default
            </label>
            <label>VAT rate (basis points)</label>
            <input className="input" type="number" value={vat.vatRateBpsDefault} onChange={(e) => setVat({ ...vat, vatRateBpsDefault: Number(e.target.value) })} />
          </>
        )}

        {step === 3 && (
          <>
            <h3>First Service Item</h3>
            <label>Service name</label>
            <input className="input" value={catalog.name} onChange={(e) => setCatalog({ ...catalog, name: e.target.value })} />
            <label>Unit price</label>
            <input className="input" type="number" value={catalog.unitPrice} onChange={(e) => setCatalog({ ...catalog, unitPrice: e.target.value })} />
            <label>Default qty</label>
            <input className="input" type="number" value={catalog.defaultQty} onChange={(e) => setCatalog({ ...catalog, defaultQty: e.target.value })} />
          </>
        )}

        {step === 4 && (
          <>
            <h3>Create First Job</h3>
            <label>Customer name</label>
            <input className="input" value={job.customerName} onChange={(e) => setJob({ ...job, customerName: e.target.value })} />
            <label>Vehicle reg (optional)</label>
            <input className="input" value={job.vehicleReg} onChange={(e) => setJob({ ...job, vehicleReg: e.target.value })} />
          </>
        )}

        {step === 5 && (
          <>
            <h3>Invite Team Member (optional)</h3>
            <label>Email</label>
            <input className="input" value={invite.email} onChange={(e) => setInvite({ ...invite, email: e.target.value })} />
            <label>Role</label>
            <select className="input" value={invite.role} onChange={(e) => setInvite({ ...invite, role: e.target.value })}>
              <option value="STAFF">STAFF</option>
              <option value="ADMIN">ADMIN</option>
              <option value="READ_ONLY">READ_ONLY</option>
            </select>
            <p className="muted">You can invite more users later in Team settings.</p>
          </>
        )}

        {status && <p style={{ color: '#7bdba5' }}>{status}</p>}
        {error && <p style={{ color: '#ff8a8a' }}>{error}</p>}

        <div style={{ marginTop: 16 }}>
          {step > 0 && (
            <button className="button" type="button" onClick={() => setStep((step - 1) as Step)} style={{ marginRight: 10 }}>
              Back
            </button>
          )}
          <button className="button" type="button" onClick={handleStep}>
            {step === 5 ? 'Finish' : 'Save & Continue'}
          </button>
        </div>
      </div>
    </div>
  );
}
