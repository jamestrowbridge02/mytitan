import { createContext, useContext, useEffect, useMemo, useState } from 'react';
import { apiFetch, getToken } from './api';

type Plan = {
  id: string;
  name: string;
  code?: string;
  stripePriceMonthlyId?: string;
  stripePriceAnnualId?: string;
  featuresJson?: Record<string, any> | null;
  aiRequestsLimitMonthly?: number;
  aiTokensLimitMonthly?: number | null;
};

type Subscription = {
  status?: string | null;
  currentPeriodEnd?: string | null;
  planId?: string | null;
  cancelAtPeriodEnd?: boolean | null;
};

type Usage = {
  aiRequestsUsed?: number;
  aiTokensUsed?: number;
  periodStart?: string;
};

type BillingState = {
  plan: Plan | null;
  subscription: Subscription | null;
  features: Record<string, any>;
  usage: Usage | null;
  interval: 'MONTHLY' | 'ANNUAL';
  loading: boolean;
  error: string;
  refresh: () => Promise<void>;
};

const BillingContext = createContext<BillingState | undefined>(undefined);

const defaultFeatures: Record<string, any> = {
  bookings_enabled: false,
  accounting_enabled: false,
  payments_enabled: false,
  social_enabled: false,
  ai_enabled: true,
  ai_requests_limit: 200,
};

export function BillingProvider({ children }: { children: React.ReactNode }) {
  const [plan, setPlan] = useState<Plan | null>(null);
  const [subscription, setSubscription] = useState<Subscription | null>(null);
  const [features, setFeatures] = useState<Record<string, any>>(defaultFeatures);
  const [usage, setUsage] = useState<Usage | null>(null);
  const [interval, setInterval] = useState<'MONTHLY' | 'ANNUAL'>('MONTHLY');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const refresh = async () => {
    if (!getToken()) {
      setPlan(null);
      setSubscription(null);
      setFeatures(defaultFeatures);
      setUsage(null);
      setInterval('MONTHLY');
      setError('');
      return;
    }
    setLoading(true);
    setError('');
    try {
      const data = await apiFetch('/billing/me');
      const nextPlan = data?.plan ?? null;
      setPlan(nextPlan);
      setSubscription(data?.subscription ?? null);
      setFeatures(data?.features ?? nextPlan?.featuresJson ?? defaultFeatures);
      setUsage(data?.usage ?? null);
      setInterval(data?.interval || 'MONTHLY');
    } catch (err: any) {
      setError(err.message || 'Failed to load billing');
      setPlan(null);
      setSubscription(null);
      setFeatures(defaultFeatures);
      setUsage(null);
      setInterval('MONTHLY');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    refresh();
  }, []);

  const value = useMemo(
    () => ({
      plan,
      subscription,
      features,
      usage,
      interval,
      loading,
      error,
      refresh,
    }),
    [plan, subscription, features, usage, interval, loading, error],
  );

  return <BillingContext.Provider value={value}>{children}</BillingContext.Provider>;
}

export function useBilling() {
  const context = useContext(BillingContext);
  if (!context) {
    throw new Error('useBilling must be used inside BillingProvider');
  }
  return context;
}
