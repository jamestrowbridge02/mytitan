generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  READ_ONLY
}

enum TradeAccountStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum JobStatus {
  DRAFT
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  CANCELLED
}

enum BookingStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

enum WheelPricingMode {
  PER_WHEEL
  SET
}

enum EmailTemplateType {
  JOB_NOTIFICATION
  INVOICE
  BOOKING_CONFIRMATION
}

enum PlanCode {
  SOLE_TRADER
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model Company {
  id             String               @id @default(cuid())
  name           String
  timezone       String
  currency       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  users          User[]
  locations      Location[]
  tradeAccounts  TradeAccount[]
  jobs           Job[]
  bookings       Booking[]
  auditEvents    AuditEvent[]
  invoiceCounter InvoiceCounter[]
  tenantSetting  TenantSetting?
  catalogItems   ServiceCatalogItem[]
  emailTemplates EmailTemplate[]
  aiChatAudits   AiChatAudit[]
  subscriptions  TenantSubscription?
  usageMeters    UsageMeter[]
  inviteTokens   InviteToken[]
}

model User {
  id               String        @id @default(cuid())
  companyId        String
  email            String
  passwordHash     String
  role             UserRole       @default(STAFF)
  createdAt        DateTime      @default(now())
  lastActiveAt     DateTime?
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedBookings Booking[]     @relation("BookingAssignee")
  auditEvents      AuditEvent[]  @relation("AuditActor")
  aiChatAudits     AiChatAudit[] @relation("AiAuditActor")

  @@unique([companyId, email])
}

model Location {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  timezone     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs         Job[]
  bookings     Booking[]
}

model TradeAccount {
  id                 String             @id @default(cuid())
  companyId          String
  name               String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  creditLimit        Decimal            @db.Decimal(14, 2)
  outstandingBalance Decimal            @default(0) @db.Decimal(14, 2)
  status             TradeAccountStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Job {
  id               String            @id @default(cuid())
  companyId        String
  locationId       String?
  jobRef           String
  status           JobStatus         @default(OPEN)
  customerName     String
  customerEmail    String?
  customerPhone    String?
  vehicleMake      String?
  vehicleModel     String?
  vehicleReg       String?
  serviceName      String?
  wheelPricingMode WheelPricingMode?
  whatsappTemplate String?
  laborCents       Int               @default(0)
  partsCents       Int               @default(0)
  miscCents        Int               @default(0)
  subtotalCents    Int               @default(0)
  taxRateBps       Int               @default(0)
  taxCents         Int               @default(0)
  totalCents       Int               @default(0)
  currency         String
  invoiceNumber    String?
  invoicePdfUrl    String?
  paymentLinkUrl   String?
  invoiceIssuedAt  DateTime?
  invoiceDueAt     DateTime?
  invoicePaidAt    DateTime?
  approvedAt       DateTime?
  approvedByName   String?
  signedAt         DateTime?
  signatureName    String?
  signatureDataUrl String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location         Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  media            JobMedia[]
  bookings         Booking[]
  publicTokens     PublicJobToken[]

  @@unique([companyId, jobRef])
  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model Booking {
  id             String        @id @default(cuid())
  companyId      String
  locationId     String?
  jobId          String?
  startsAt       DateTime
  endsAt         DateTime
  assignedUserId String?
  status         BookingStatus @default(PLANNED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location       Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assignedUser   User?         @relation("BookingAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
}

model JobMedia {
  id        String    @id @default(cuid())
  jobId     String
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  type      String
  message   String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model InvoiceCounter {
  id        String  @id @default(cuid())
  companyId String
  year      Int
  current   Int     @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year])
}

model TenantSetting {
  id                          String            @id @default(cuid())
  tenantId                    String            @unique
  planId                      String?
  planBillingInterval         BillingInterval   @default(MONTHLY)
  companyName                 String?
  logoUrl                     String?
  brandPrimaryColor           String            @default("#4fd1c5")
  brandSecondaryColor         String            @default("#1a1f36")
  brandAccentColor            String?
  brandDefaultMode            String            @default("dark")
  emailSenderName             String?
  emailReplyTo                String?
  emailNotificationRecipients Json?
  smtpHost                    String?
  smtpPort                    Int?
  smtpUsername                String?
  smtpPasswordEncrypted       String?
  whatsappTemplateDefault     String?
  vatEnabledDefault           Boolean           @default(false)
  vatRateBpsDefault           Int               @default(0)
  defaultCurrency             String            @default("USD")
  defaultLocale               String            @default("en-US")
  defaultTimezone             String            @default("UTC")
  defaultItems                Json?
  defaultServiceNamePresets   Json?
  defaultWheelPricingMode     WheelPricingMode?
  bookingsEnabled             Boolean           @default(false)
  accountingEnabled           Boolean           @default(false)
  paymentsEnabled             Boolean           @default(false)
  socialEnabled               Boolean           @default(false)
  aiEnabled                   Boolean           @default(true)
  onboardingCompleted         Boolean           @default(false)
  onboardingStep              Int               @default(0)
  featurePayments             Boolean           @default(false)
  featureAccounting           Boolean           @default(false)
  featureBookings             Boolean           @default(false)
  featureSocial               Boolean           @default(false)
  featureAI                   Boolean           @default(false)
  featureCustomerPortal       Boolean           @default(false)
  featureWhatsApp             Boolean           @default(false)
  aiRequestsLimit             Int?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  tenant                      Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                        Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model ServiceCatalogItem {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  unitPrice  Decimal  @db.Decimal(14, 2)
  defaultQty Int      @default(1)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model EmailTemplate {
  id        String            @id @default(cuid())
  tenantId  String
  type      EmailTemplateType
  subject   String
  bodyHtml  String?
  bodyText  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model AiChatAudit {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  prompt       String
  response     String?
  promptTokens Int?
  outputTokens Int?
  totalTokens  Int?
  createdAt    DateTime @default(now())
  tenant       Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation("AiAuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Plan {
  id                    String          @id @default(cuid())
  code                  PlanCode        @unique
  name                  String
  stripePriceMonthlyId  String
  stripePriceAnnualId   String
  featuresJson          Json?
  aiRequestsLimitMonthly Int
  aiTokensLimitMonthly  Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  subscriptions         TenantSubscription[]
  tenantSettings        TenantSetting[]
}

model TenantSubscription {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  planId                String
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  status                String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                  Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model UsageMeter {
  id              String   @id @default(cuid())
  tenantId        String
  periodStart     DateTime
  aiRequestsUsed  Int      @default(0)
  aiTokensUsed    Int      @default(0)
  storageBytesUsed Int     @default(0)
  jobsCreatedCount Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId, createdAt])
}

model InviteToken {
  id         String   @id @default(cuid())
  tenantId   String
  email      String
  role       UserRole
  token      String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  tenant     Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
}

model PublicJobToken {
  id        String   @id @default(cuid())
  jobId     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
