server {
    listen 80;
    server_name mytitan.co.uk www.mytitan.co.uk;
    return 308 https://app.mytitan.co.uk$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mytitan.co.uk www.mytitan.co.uk;

    ssl_certificate /etc/letsencrypt/live/mytitan.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mytitan.co.uk/privkey.pem;

    return 308 https://app.mytitan.co.uk$request_uri;
}
