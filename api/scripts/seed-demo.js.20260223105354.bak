#!/usr/bin/env node
/* eslint-disable no-console */
const { PrismaClient } = require('@prisma/client');
const bcrypt = require('bcryptjs');

const prisma = new PrismaClient();
const DEMO_COMPANY_NAME = '';
const TEMP_PASSWORD = 'ChangeMeNow!234';
const ADMIN_EMAIL = 'admin@mytitan.co.uk';
const DEMO_EMAIL = '@mytitan.co.uk';

async function ensureDemoCompany() {
  let company = await prisma.company.findFirst({
    where: { name: DEMO_COMPANY_NAME },
    orderBy: { createdAt: 'asc' },
  });

  if (!company) {
    company = await prisma.company.create({
      data: {
        name: DEMO_COMPANY_NAME,
        timezone: 'UTC',
        currency: 'GBP',
      },
    });
  }

  const defaultPlan = await prisma.plan.findFirst({
    where: { code: 'SOLE_TRADER' },
  });

  await prisma.tenantSetting.upsert({
    where: { tenantId: company.id },
    create: {
      tenantId: company.id,
      planId: defaultPlan ? defaultPlan.id : null,
      companyName: company.name,
      defaultCurrency: company.currency || 'GBP',
      defaultTimezone: company.timezone || 'UTC',
    },
    update: {
      companyName: company.name,
      defaultCurrency: company.currency || 'GBP',
      defaultTimezone: company.timezone || 'UTC',
      ...(defaultPlan ? { planId: defaultPlan.id } : {}),
    },
  });

  return company;
}

async function ensureUser(companyId, email, role) {
  const normalizedEmail = email.toLowerCase().trim();
  const existing = await prisma.user.findFirst({
    where: { companyId, email: normalizedEmail },
  });

  if (existing) {
    return 'exists';
  }

  const passwordHash = await bcrypt.hash(TEMP_PASSWORD, 10);
  await prisma.user.create({
    data: {
      companyId,
      email: normalizedEmail,
      passwordHash,
      role,
    },
  });
  return 'created';
}

async function main() {
  const company = await ensureDemoCompany();
  const ownerRole = 'OWNER';
  const adminStatus = await ensureUser(company.id, ADMIN_EMAIL, ownerRole);
  const demoStatus = await ensureUser(company.id, DEMO_EMAIL, 'STAFF');

  console.log(`${ADMIN_EMAIL} (${adminStatus})`);
  console.log(`${DEMO_EMAIL} (${demoStatus})`);
  console.log(`Temporary password: ${TEMP_PASSWORD}`);
}

main()
  .catch((err) => {
    console.error('Seed failed.');
    if (err && err.message) {
      console.error(err.message);
    }
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
