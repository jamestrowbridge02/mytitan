generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  DISPATCHER
  FINANCE
  TECHNICIAN
  VIEWER
  STAFF
  READ_ONLY
}

enum TradeAccountStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum CRMTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobStatus {
  DRAFT
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingSource {
  INTERNAL
  PUBLIC
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

enum WheelPricingMode {
  PER_WHEEL
  SET
}

enum EmailTemplateType {
  JOB_NOTIFICATION
  INVOICE
  BOOKING_CONFIRMATION
}

enum PlanCode {
  SOLE_TRADER
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum CustomFieldEntityType {
  JOB
  BOOKING
  CUSTOMER
  TECHNICIAN
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
  DATE
}

enum IntegrationProvider {
  XERO
  QBO
  GOOGLE_CALENDAR
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DocumentArtifactEntityType {
  JOB
  CUSTOMER
}

enum DocumentArtifactKind {
  INVOICE
  RECEIPT
  JOB_ATTACHMENT
  CUSTOMER_ATTACHMENT
  PORTAL_DOCUMENT
}

enum ServicePlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ServicePlanCadenceUnit {
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum ServicePlanRunStatus {
  PENDING
  EXECUTED
  SKIPPED
  FAILED
}

enum NextActionType {
  CALL
  EMAIL
  WHATSAPP
  FOLLOW_UP
  MEETING
}

enum TemplatePresetType {
  CATALOG_ITEM
  PRICING_PRESET
  CHECKLIST
  EMAIL_TEMPLATE
  PDF_TEMPLATE
  BOOKING_DEFAULTS
  PORTAL_COPY
}

enum JobAssetKind {
  BEFORE
  AFTER
  TORQUE
  SIGN_TECH
  SIGN_CUSTOMER
}

enum StockPurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model Company {
  id                       String                    @id @default(cuid())
  name                     String
  timezone                 String
  currency                 String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  users                    User[]
  locations                Location[]
  tradeAccounts            TradeAccount[]
  jobs                     Job[]
  bookings                 Booking[]
  bookingBusinessHours     BookingBusinessHour[]
  bookingBlackoutDates     BookingBlackoutDate[]
  auditEvents              AuditEvent[]
  invoiceCounter           InvoiceCounter[]
  tenantSetting            TenantSetting?
  catalogItems             ServiceCatalogItem[]
  emailTemplates           EmailTemplate[]
  aiChatAudits             AiChatAudit[]
  subscriptions            TenantSubscription?
  usageMeters              UsageMeter[]
  inviteTokens             InviteToken[]
  integrationConnections   IntegrationConnection[]
  integrationAuthStates    IntegrationAuthState[]
  apiTokens                ApiToken[]
  webhookEndpoints         WebhookEndpoint[]
  webhookDeliveries        WebhookDelivery[]
  documentArtifacts        DocumentArtifact[]
  servicePlans             ServicePlan[]
  servicePlanRuns          ServicePlanRun[]
  tradePackInstalls        TradePackInstall[]
  templatePresets          TemplatePreset[]
  tradeAccountNotes        TradeAccountNote[]
  jobDrafts                JobDraft[]
  crmDrafts                CrmDraft[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  savedCommandViews        SavedCommandView[]
  userUndoActions          UserUndoAction[]
  locationBusinessHours    LocationBusinessHour[]
  locationStaffAssignments LocationStaffAssignment[]
  jobLineItems             JobLineItem[]
  stockItems               StockItem[]
  stockSuppliers           StockSupplier[]
  stockPurchaseOrders      StockPurchaseOrder[]
  stockMovements           StockMovement[]
  jobActivities            JobActivity[]
  jobTags                  JobTag[]
  savedBoardViews          SavedBoardView[]
  jobReminders             JobReminder[]
  services                 Service[]
  staffAvailabilities      StaffAvailability[]
  techScheduleSettings     TechScheduleSetting[]
  techScheduleExceptions   TechScheduleException[]
  technicianAvailabilities TechnicianAvailability[]
  technicianCapacityExceptions TechnicianCapacityException[]
  blackoutDates            BlackoutDate[]
  bookingQuestions         BookingQuestion[]
  bookingAnswers           BookingAnswer[]
  customerTags             CustomerTag[]
  customerSegments         CustomerSegment[]
  customers                Customer[]
  crmNotes                 CRMNote[]
  crmTasks                 CRMTask[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  jobSignatures            JobSignature[]
  automationsSetting       AutomationsSetting?
  automationRules          AutomationRule[]
  automationSuggestionStates AutomationSuggestionState[]
  customFields             CustomField[]
  customFieldValues        CustomFieldValue[]
}

model User {
  id                       String                    @id @default(cuid())
  companyId                String
  email                    String
  emailVerified            Boolean                   @default(false)
  passwordHash             String
  role                     UserRole                  @default(STAFF)
  tokenVersion             Int                       @default(0)
  onlyMyLocation           Boolean                   @default(false)
  defaultLocationId        String?
  createdAt                DateTime                  @default(now())
  lastActiveAt             DateTime?
  lastLoginAt              DateTime?
  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultLocation          Location?                 @relation("UserDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  defaultAssignedLocations Location[]                @relation("LocationDefaultAssignee")
  locationAssignments      LocationStaffAssignment[]
  savedCommandViews        SavedCommandView[]
  savedBoardViews          SavedBoardView[]
  undoActions              UserUndoAction[]
  assignedBookings         Booking[]                 @relation("BookingAssignee")
  assignedJobs             Job[]                     @relation("JobAssignee")
  auditEvents              AuditEvent[]              @relation("AuditActor")
  aiChatAudits             AiChatAudit[]             @relation("AiAuditActor")
  jobDrafts                JobDraft[]
  crmDrafts                CrmDraft[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  jobActivities            JobActivity[]             @relation("JobActivityActor")
  crmNotes                 CRMNote[]                 @relation("CRMNoteAuthor")
  crmTasks                 CRMTask[]                 @relation("CRMTaskAssignee")
  staffAvailabilities      StaffAvailability[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  createdJobs              Job[]                     @relation("JobCreator")
  technicianAvailabilities TechnicianAvailability[] @relation("TechnicianAvailabilityUser")
  technicianCapacityExceptions TechnicianCapacityException[] @relation("TechnicianCapacityExceptionUser")

  @@unique([companyId, email])
}

model Location {
  id                    String                    @id @default(cuid())
  companyId             String
  name                  String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String?
  postalCode            String?
  country               String
  phone                 String?
  isActive              Boolean                   @default(true)
  timezone              String?
  bookingLeadTimeMins   Int                       @default(0)
  defaultAssigneeId     String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultAssignee       User?                     @relation("LocationDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  jobs                  Job[]
  bookings              Booking[]
  businessHours         LocationBusinessHour[]
  staffAssignments      LocationStaffAssignment[]
  defaultUsers          User[]                    @relation("UserDefaultLocation")
  stockItems            StockItem[]
  stockPurchaseOrders   StockPurchaseOrder[]
  stockMovements        StockMovement[]
  tenantSettingsDefault TenantSetting[]           @relation("TenantDefaultLocation")
  services              Service[]
  staffAvailabilities   StaffAvailability[]
  blackoutDates         BlackoutDate[]
  bookingQuestions      BookingQuestion[]
  savedBoardViews       SavedBoardView[]

  @@index([companyId, isActive])
  @@index([companyId, defaultAssigneeId])
}

model TradeAccount {
  id                 String             @id @default(cuid())
  companyId          String
  name               String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  creditLimit        Decimal            @db.Decimal(14, 2)
  outstandingBalance Decimal            @default(0) @db.Decimal(14, 2)
  status             TradeAccountStatus @default(ACTIVE)
  nextActionType     NextActionType?
  nextActionDueAt    DateTime?
  nextActionUserId   String?
  lastContactedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes              TradeAccountNote[]
  jobs               Job[]
  bookings           Booking[]
  customerTags       CustomerTag[]
  crmNotes           CRMNote[]
  crmTasks           CRMTask[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model Customer {
  id             String          @id @default(cuid())
  companyId      String
  slug           String?
  name           String
  email          String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs           Job[]
  activityEvents ActivityEvent[]
  servicePlans   ServicePlan[]

  @@unique([companyId, slug])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, createdAt])
}

model Job {
  id                       String            @id @default(cuid())
  companyId                String
  locationId               String?
  customerId               String?
  jobRef                   String
  status                   JobStatus         @default(OPEN)
  customerName             String
  customerEmail            String?
  customerPhone            String?
  vehicleMake              String?
  vehicleModel             String?
  vehicleReg               String?
  serviceName              String?
  wheelPricingMode         WheelPricingMode?
  whatsappTemplate         String?
  laborCents               Int               @default(0)
  partsCents               Int               @default(0)
  miscCents                Int               @default(0)
  subtotalCents            Int               @default(0)
  taxRateBps               Int               @default(0)
  taxCents                 Int               @default(0)
  totalCents               Int               @default(0)
  currency                 String
  invoiceNumber            String?
  invoicePdfUrl            String?
  paymentLinkUrl           String?
  invoiceIssuedAt          DateTime?
  invoiceDueAt             DateTime?
  invoicePaidAt            DateTime?
  scheduledAt              DateTime?
  approvedAt               DateTime?
  approvedByName           String?
  declinedAt               DateTime?
  declinedReason           String?
  signedAt                 DateTime?
  signatureName            String?
  signatureDataUrl         String?
  paymentCheckoutSessionId String?
  paymentReceiptUrl        String?
  tradeAccountId           String?
  assignedUserId           String?
  createdByUserId          String?
  pricingNotes             String?
  tags                     String[]          @default([])
  completedAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location                 Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer                 Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tradeAccount             TradeAccount?     @relation(fields: [tradeAccountId], references: [id], onDelete: SetNull)
  assignedUser             User?             @relation("JobAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser            User?             @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  media                    JobMedia[]
  bookings                 Booking[]
  publicTokens             PublicJobToken[]
  assets                   JobAsset[]
  pdf                      JobPdf?
  stockMovements           StockMovement[]
  lineItems                JobLineItem[]
  tradeCode                String?
  jobType                  String?
  formData                 Json?
  whatsappCompletionLink   String?
  activities               JobActivity[]
  reminders                JobReminder[]
  signatures               JobSignature[]

  @@unique([companyId, jobRef])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, invoiceIssuedAt])
  @@index([companyId, invoicePaidAt])
  @@index([companyId, jobType])
  @@index([companyId, tradeCode])
  @@index([companyId, tradeAccountId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, locationId, status, createdAt])
  @@index([companyId, status, invoiceDueAt, locationId])
  @@index([companyId, completedAt])
  @@index([companyId, createdByUserId])
}

model SavedCommandView {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  name        String
  filtersJson Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, createdAt])
  @@index([companyId, userId, isDefault])
}

model UserUndoAction {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  actionType  String
  payloadJson Json
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, createdAt])
  @@index([companyId, userId, expiresAt])
  @@index([companyId, userId, consumedAt])
}

model LocationBusinessHour {
  id          String   @id @default(cuid())
  companyId   String
  locationId  String
  weekday     Int
  startMinute Int?
  endMinute   Int?
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekday])
  @@index([companyId, locationId])
}

model LocationStaffAssignment {
  id         String   @id @default(cuid())
  companyId  String
  locationId String
  userId     String
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId])
  @@index([companyId, userId])
  @@index([companyId, locationId])
}

model JobLineItem {
  id          String     @id @default(cuid())
  companyId   String
  jobId       String
  stockItemId String?
  description String
  qty         Decimal    @db.Decimal(14, 2)
  unitPrice   Decimal    @default(0) @db.Decimal(14, 2)
  total       Decimal    @default(0) @db.Decimal(14, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId, createdAt])
  @@index([companyId, stockItemId])
}

model Booking {
  id             String              @id @default(cuid())
  companyId      String
  locationId     String?
  jobId          String?
  serviceId      String?
  proServiceId   String?
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  tradeAccountId String?
  startsAt       DateTime
  endsAt         DateTime
  assignedUserId String?
  status         BookingStatus       @default(PLANNED)
  source         BookingSource       @default(INTERNAL)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location       Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  job            Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assignedUser   User?               @relation("BookingAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  service        ServiceCatalogItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tradeAccount   TradeAccount?       @relation(fields: [tradeAccountId], references: [id], onDelete: SetNull)
  proService     Service?            @relation(fields: [proServiceId], references: [id], onDelete: SetNull)
  answers        BookingAnswer[]

  @@index([companyId, startsAt])
  @@index([companyId, tradeAccountId, startsAt])
  @@index([companyId, locationId, startsAt, endsAt])
}

model JobActivity {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  actorUserId String?
  eventType   String
  message     String?
  payloadJson Json?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorUser   User?    @relation("JobActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId, createdAt])
  @@index([companyId, createdAt])
}

model JobTag {
  id        String   @id @default(cuid())
  companyId String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, createdAt])
}

model SavedBoardView {
  id                String    @id @default(cuid())
  companyId         String
  userId            String
  name              String
  viewType          String    @default("kanban")
  filtersJson       Json
  isDefault         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location          Location? @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  defaultLocationId String?

  @@index([companyId, userId, createdAt])
  @@index([companyId, userId, isDefault])
}

model JobReminder {
  id          String    @id @default(cuid())
  companyId   String
  jobId       String
  remindAt    DateTime
  channel     String    @default("in_app")
  note        String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, remindAt])
  @@index([companyId, jobId, remindAt])
}

model Service {
  id              String    @id @default(cuid())
  companyId       String
  locationId      String?
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  bufferBefore    Int       @default(0)
  bufferAfter     Int       @default(0)
  depositCents    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookings        Booking[]

  @@index([companyId, locationId, isActive])
  @@index([companyId, createdAt])
}

model StaffAvailability {
  id          String   @id @default(cuid())
  companyId   String
  locationId  String
  userId      String
  weekday     Int
  startMinute Int?
  endMinute   Int?
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId, weekday])
  @@index([companyId, locationId])
  @@index([companyId, userId])
}

model TechScheduleSetting {
  id           String   @id @default(uuid())
  companyId    String
  technicianId String
  weeklyJson   Json
  timezone     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, technicianId])
  @@index([companyId, technicianId])
}

model TechScheduleException {
  id           String   @id @default(uuid())
  companyId    String
  technicianId String
  startsAt     DateTime
  endsAt       DateTime
  allDay       Boolean  @default(false)
  reason       String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, technicianId, startsAt])
}

enum TechnicianCapacityExceptionType {
  UNAVAILABLE
  REDUCED_CAPACITY
  OVERTIME
}

model TechnicianAvailability {
  id              String   @id @default(cuid())
  tenantId        String
  technicianId    String
  date            DateTime
  startTime       String
  endTime         String
  capacityMinutes Int
  notesJson       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  technician      User     @relation("TechnicianAvailabilityUser", fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([tenantId, technicianId, date])
  @@index([tenantId, date])
}

model TechnicianCapacityException {
  id              String                          @id @default(cuid())
  tenantId        String
  technicianId    String
  date            DateTime
  type            TechnicianCapacityExceptionType
  startTime       String
  endTime         String
  capacityMinutes Int
  reason          String?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  tenant          Company                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  technician      User                            @relation("TechnicianCapacityExceptionUser", fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([tenantId, technicianId, date])
  @@index([tenantId, date, type])
}

model BlackoutDate {
  id         String    @id @default(cuid())
  companyId  String
  locationId String?
  date       DateTime
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([companyId, locationId, date])
}

model BookingQuestion {
  id          String          @id @default(cuid())
  companyId   String
  locationId  String?
  label       String
  questionKey String
  type        String          @default("text")
  required    Boolean         @default(false)
  optionsJson Json?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location    Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  answers     BookingAnswer[]

  @@unique([companyId, questionKey])
  @@index([companyId, locationId, isActive])
}

model BookingAnswer {
  id         String          @id @default(cuid())
  companyId  String
  bookingId  String
  questionId String
  valueText  String?
  valueJson  Json?
  createdAt  DateTime        @default(now())
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  question   BookingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingId])
  @@index([companyId, questionId])
}

model CustomerTag {
  id             String       @id @default(cuid())
  companyId      String
  tradeAccountId String
  label          String
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tradeAccount   TradeAccount @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)

  @@unique([companyId, tradeAccountId, label])
  @@index([companyId, tradeAccountId, createdAt])
}

model CustomerSegment {
