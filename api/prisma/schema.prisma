  tenantId                    String                        @unique
  planId                      String
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  status                      String?
  trialStartedAt              DateTime?
  trialEndsAt                 DateTime?
  trialPausedAt               DateTime?
  trialPausedRemainingSeconds Int?
  currentPeriodEnd            DateTime?
  cancelAtPeriodEnd           Boolean                       @default(false)
  convertedAt                 DateTime?
  conversionSource            SubscriptionConversionSource?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  tenant                      Company                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                        Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model UsageMeter {
  id               String   @id @default(cuid())
  tenantId         String
  periodStart      DateTime
  aiRequestsUsed   Int      @default(0)
  aiTokensUsed     Int      @default(0)
  storageBytesUsed Int      @default(0)
  jobsCreatedCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId, createdAt])
}

model BillingCatalogSync {
  id            String   @id @default(cuid())
  key           String   @unique
  status        String
  snapshotJson  Json?
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JobCompletionPackPurchase {
  id                    String    @id @default(cuid())
  tenantId              String
  packCode              String
  status                String
  checkoutSessionId     String    @unique
  stripePaymentIntentId String?
  stripeEventId         String?
  productId             String?
  priceId               String?
  currency              String
  amountCents           Int
  jobCompletionCount    Int
  purchasePeriodStart   DateTime
  expiresAt             DateTime?
  purchasedAt           DateTime?
  failedAt              DateTime?
  metadataJson          Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchasePeriodStart, status])
  @@index([tenantId, createdAt])
}

model TenantJobAllowanceOverride {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  monthlyJobAllowance     Int?
  recurringExtraAllowance Int      @default(0)
  unlimitedJobs           Boolean  @default(false)
  enterprisePlanNote      String?
  reason                  String
  createdByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser           User?    @relation("TenantJobAllowanceOverrideCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, updatedAt])
}

model TenantJobAllowanceCredit {
  id              String    @id @default(cuid())
  tenantId        String
  creditCount     Int
  creditType      String
  expiresAt       DateTime?
  reason          String
  createdByUserId String?
  createdAt       DateTime  @default(now())
  tenant          Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser   User?     @relation("TenantJobAllowanceCreditCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, expiresAt, createdAt])
  @@index([tenantId, creditType, createdAt])
}

model BookingBusinessHour {
  id          String   @id @default(cuid())
  tenantId    String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dayOfWeek])
}

model BookingBlackoutDate {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model IntegrationConnection {
  id                    String                     @id @default(cuid())
  tenantId              String
  provider              IntegrationProvider
  scope                 IntegrationConnectionScope @default(WORKSPACE)
  scopeOwnerKey         String                     @default("workspace")
  ownerUserId           String?
  status                String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  scopes                String?
  externalTenantId      String?
  realmId               String?
  connectedAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Company                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUser             User?                      @relation("UserIntegrationConnections", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, scope, scopeOwnerKey])
  @@index([tenantId, provider, scope, ownerUserId])
}

model IntegrationAuthState {
  id          String                     @id @default(cuid())
  tenantId    String
  provider    IntegrationProvider
  scope       IntegrationConnectionScope @default(WORKSPACE)
  ownerUserId String?
  state       String                     @unique
  expiresAt   DateTime
  createdAt   DateTime                   @default(now())
  tenant      Company                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUser   User?                      @relation("UserIntegrationAuthStates", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, provider, scope, ownerUserId])
}

model IntegrationCredential {
  id                      String                      @id @default(cuid())
  tenantId                String
  provider                TenantIntegrationProvider
  credentialType          IntegrationCredentialType
  scope                   IntegrationConnectionScope  @default(WORKSPACE)
  scopeOwnerKey           String                      @default("workspace")
  userId                  String?
  displayName             String?
  status                  IntegrationCredentialStatus @default(SETUP_NEEDED)
  encryptedPayload        String?
  encryptedSecretMaterial String?
  metadataJson            Json?
  routeId                 String                      @unique
  lastVerifiedAt          DateTime?
  lastWebhookReceivedAt   DateTime?
  lastErrorCategory       String?
  createdByUserId         String?
  updatedByUserId         String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  tenant                  Company                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User?                       @relation("UserPersonalIntegrationCredentials", fields: [userId], references: [id], onDelete: SetNull)
  createdBy               User?                       @relation("UserCreatedIntegrationCredentials", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy               User?                       @relation("UserUpdatedIntegrationCredentials", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  webhookReceipts         IntegrationWebhookReceipt[]

  @@unique([tenantId, provider, scope, scopeOwnerKey])
  @@index([tenantId, provider, scope, userId])
  @@index([provider, routeId])
}

model IntegrationWebhookReceipt {
  id                      String                    @id @default(cuid())
  tenantId                String
  integrationCredentialId String
  provider                TenantIntegrationProvider
  routeId                 String
  eventId                 String
  eventType               String?
  status                  String
  errorCategory           String?
  receivedAt              DateTime                  @default(now())
  processedAt             DateTime?
  lastAttemptAt           DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tenant                  Company                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationCredential   IntegrationCredential     @relation(fields: [integrationCredentialId], references: [id], onDelete: Cascade)

  @@unique([provider, integrationCredentialId, eventId])
  @@index([tenantId, provider, routeId, receivedAt])
}

model IntegrationOrchestrationEvent {
  id            String                     @id @default(cuid())
  tenantId      String
  provider      TenantIntegrationProvider
  scope         IntegrationConnectionScope @default(WORKSPACE)
  scopeOwnerKey String                     @default("workspace")
  userId        String?
  action        String
  safeCategory  String
  result        String
  message       String?
  metadataJson  Json?
  createdAt     DateTime                   @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, provider, scope, createdAt])
}

model Asset {
  id                  String                 @id @default(cuid())
  tenantId            String
  name                String
  equipmentType       String
  serialNumber        String?
  locationId          String?
  assignedOperatorId  String?
  assignedJobId       String?
  status              AssetOperationalStatus @default(AVAILABLE)
  maintenanceDueAt    DateTime?
  lastInspectionAt    DateTime?
  inspectionHistory   Json?
  requiredForTemplate String?
  checkedOutAt        DateTime?
  checkedInAt         DateTime?
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Company                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNumber])
  @@index([tenantId, status, locationId])
  @@index([tenantId, assignedOperatorId, assignedJobId])
}

model FinancialApprovalPolicy {
  id              String                @id @default(cuid())
  tenantId        String
  kind            FinancialApprovalKind
  role            String?
  locationId      String?
  limitCents      Int
  active          Boolean               @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, role, locationId])
  @@index([tenantId, active, kind])
}

model FinancialApprovalRequest {
  id                       String                         @id @default(cuid())
  tenantId                 String
  kind                     FinancialApprovalKind
  amountCents              Int
  locationId               String?
  jobId                    String?
  requestedByUserId        String
  reason                   String?
  status                   FinancialApprovalRequestStatus @default(PENDING)
  decidedByUserId          String?
  decidedAt                DateTime?
  decisionNote             String?
  customerApprovalRequired Boolean                        @default(false)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  tenant                   Company                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, jobId])
}

model VehicleLookupAudit {
  id                String   @id @default(cuid())
  tenantId          String
  registration      String
  provider          String
  result            String
  safeCategory      String
  requestedByUserId String?
  responseJson      Json?
  createdAt         DateTime @default(now())
  tenant            Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, registration, createdAt])
}

model ApiToken {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  publicId        String    @unique
  tokenPrefix     String
  tokenHash       String    @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, revokedAt])
}

model WebhookEndpoint {
  id                   String            @id @default(cuid())
  tenantId             String
  name                 String
  url                  String
  secretEncrypted      String?
  secretLastFour       String?
  subscribedEventTypes String[]          @default([])
  active               Boolean           @default(true)
  createdByUserId      String?
  lastDeliveryAt       DateTime?
  lastSuccessAt        DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  tenant               Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries           WebhookDelivery[]

  @@index([tenantId, active, createdAt])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  tenantId       String
  endpointId     String
  eventType      String
  eventId        String?
  requestUrl     String
  status         WebhookDeliveryStatus @default(PENDING)
  payloadJson    Json
  signature      String?
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  durationMs     Int?
  attemptedAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([endpointId, createdAt])
}

model DocumentArtifact {
  id                String                     @id @default(cuid())
  tenantId          String
  entityType        DocumentArtifactEntityType
  entityId          String
  kind              DocumentArtifactKind
  label             String
  fileName          String?
  storagePath       String?
  externalUrl       String?
  mimeType          String?
  sizeBytes         Int?
  portalVisible     Boolean                    @default(false)
  createdByUserId   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            Company                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executionEvidence JobExecutionEvidence[]

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, entityType, entityId, kind])
  @@index([tenantId, portalVisible, createdAt])
}

model JobExecutionRecord {
  id             String                   @id @default(cuid())
  tenantId       String
  jobId          String
  technicianId   String?
  status         JobExecutionRecordStatus @default(IN_PROGRESS)
  startedAt      DateTime?
  completedAt    DateTime?
  submittedAt    DateTime?
  acknowledgedAt DateTime?
  summary        String?
  checklistJson  Json?
  notesJson      Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  tenant         Company                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job            Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician     User?                    @relation("JobExecutionTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  evidence       JobExecutionEvidence[]

  @@index([tenantId, jobId, createdAt])
  @@index([tenantId, technicianId, status, createdAt])
  @@index([tenantId, status, updatedAt])
}

model JobExecutionEvidence {
  id                String                   @id @default(cuid())
  tenantId          String
  jobId             String
  executionRecordId String
  kind              JobExecutionEvidenceKind
  label             String
  artifactId        String?
  payloadJson       Json?
  createdBy         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenant            Company                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job               Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  executionRecord   JobExecutionRecord       @relation(fields: [executionRecordId], references: [id], onDelete: Cascade)
  artifact          DocumentArtifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  createdByUser     User?                    @relation("JobExecutionEvidenceCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, jobId, createdAt])
  @@index([tenantId, executionRecordId, createdAt])
  @@index([tenantId, kind, createdAt])
}

model Quote {
  id                     String                  @id @default(cuid())
  tenantId               String
  customerId             String
  jobId                  String?
  bookingId              String?
  quoteNumber            String
  status                 QuoteStatus             @default(DRAFT)
  title                  String
  summary                String?
  subtotalCents          Int                     @default(0)
  taxCents               Int                     @default(0)
  totalCents             Int                     @default(0)
  currency               String
  expiresAt              DateTime?
  approvedAt             DateTime?
  declinedAt             DateTime?
  convertedAt            DateTime?
  createdByUserId        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Company                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job                    Job?                    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  booking                Booking?                @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdByUser          User?                   @relation("QuoteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems              QuoteLineItem[]
  revenueCollectionTasks RevenueCollectionTask[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, jobId])
  @@index([tenantId, bookingId])
}

model QuoteLineItem {
  id              String            @id @default(cuid())
  quoteId         String
  sortOrder       Int               @default(0)
  type            QuoteLineItemType
  title           String
  description     String?
  quantity        Decimal           @db.Decimal(10, 2)
  unitPriceCents  Int
  totalPriceCents Int
  metadataJson    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  quote           Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
}

model RevenueCollectionTask {
  id          String                      @id @default(cuid())
  tenantId    String
  jobId       String?
  quoteId     String?
  customerId  String
  kind        RevenueCollectionTaskKind
  status      RevenueCollectionTaskStatus @default(OPEN)
  dueAt       DateTime
  completedAt DateTime?
  notesJson   Json?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  tenant      Company                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job         Job?                        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote       Quote?                      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer    Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, customerId, status])
  @@index([tenantId, kind, status])
  @@index([tenantId, quoteId, kind])
  @@index([tenantId, jobId, kind])
}

model ServicePlan {
  id                String                     @id @default(cuid())
  tenantId          String
  customerId        String
  locationId        String?
  name              String
  description       String?
  status            ServicePlanStatus          @default(ACTIVE)
  cadenceUnit       ServicePlanCadenceUnit
  cadenceInterval   Int
  nextRunAt         DateTime?
  lastRunAt         DateTime?
  autoCreateBooking Boolean                    @default(false)
  autoCreateJob     Boolean                    @default(false)
  notesJson         Json?
  portalVisible     Boolean                    @default(false)
  createdByUserId   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            Company                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location          Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tasks             ServicePlanTask[]
  runs              ServicePlanRun[]
  renewals          ServicePlanRenewal[]
  changeRequests    ServicePlanChangeRequest[]

  @@index([tenantId, status, nextRunAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, locationId, status, nextRunAt])
}

model ServicePlanTask {
  id           String      @id @default(cuid())
  planId       String
  title        String
  description  String?
  sortOrder    Int         @default(0)
  metadataJson Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  plan         ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

model ServicePlanRun {
  id           String               @id @default(cuid())
  tenantId     String
  planId       String
  scheduledFor DateTime
  executedAt   DateTime?
  status       ServicePlanRunStatus @default(PENDING)
  bookingId    String?
  jobId        String?
  resultJson   Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tenant       Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         ServicePlan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, scheduledFor])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, createdAt])
}

model ServicePlanRenewal {
  id                   String                   @id @default(cuid())
  tenantId             String
  planId               String
  customerId           String
  status               ServicePlanRenewalStatus @default(PENDING)
  renewalWindowStartAt DateTime
  renewalWindowEndAt   DateTime
  requestedAt          DateTime                 @default(now())
  respondedAt          DateTime?
  completedAt          DateTime?
  notesJson            Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tenant               Company                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 ServicePlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  customer             Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, renewalWindowStartAt])
  @@index([tenantId, customerId, status])
  @@index([tenantId, planId, createdAt])
}

model ServicePlanChangeRequest {
  id           String                         @id @default(cuid())
  tenantId     String
  planId       String
  customerId   String
  status       ServicePlanChangeRequestStatus @default(OPEN)
  kind         ServicePlanChangeRequestKind
  requestedBy  ServicePlanRequestActor
  requestedAt  DateTime                       @default(now())
  respondedAt  DateTime?
  responseNote String?
  payloadJson  Json?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  tenant       Company                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         ServicePlan                    @relation(fields: [planId], references: [id], onDelete: Cascade)
  customer     Customer                       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, requestedAt])
  @@index([tenantId, customerId, status])
  @@index([tenantId, planId, kind])
}

model InviteToken {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       UserRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
}

model TradePack {
  code        String             @id
  name        String
  description String
  tags        String[]
  version     Int                @default(1)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  installs    TradePackInstall[]
  presets     TemplatePreset[]
}

model TradePackInstall {
  id                String    @id @default(cuid())
  tenantId          String
  packCode          String
  installedAt       DateTime  @default(now())
  installedByUserId String?
  configJson        Json?
  tenant            Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pack              TradePack @relation(fields: [packCode], references: [code], onDelete: Restrict)

  @@unique([tenantId, packCode])
  @@index([tenantId, packCode])
  @@index([tenantId, installedAt])
}

model TemplatePreset {
  id        String             @id @default(cuid())
  tenantId  String
  packCode  String
  type      TemplatePresetType
  key       String
  name      String
  dataJson  Json
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Company            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pack      TradePack          @relation(fields: [packCode], references: [code], onDelete: Restrict)

  @@unique([tenantId, packCode, type, key])
  @@index([tenantId, packCode])
  @@index([tenantId, type, isActive])
  @@index([tenantId, updatedAt])
}

model JobSheetTemplate {
  id                  String    @id @default(cuid())
  key                 String    @unique
  name                String
  tradeCategory       String
  description         String?
  status              String    @default("draft")
  isPublished         Boolean   @default(false)
  isArchived          Boolean   @default(false)
  version             Int       @default(1)
  payloadJson         Json
  metadataJson        Json?
  submittedByTenantId String?
  submittedByUserId   String?
  approvedByUserId    String?
  approvalNotes       String?
  reviewNotes         String?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tradeCategory, status])
  @@index([status, isPublished, isArchived])
  @@index([submittedByTenantId, status])
  @@index([updatedAt])
}

model JobSheetTemplateHistory {
  id              String   @id @default(cuid())
  templateId      String
  action          String
  fromStatus      String?
  toStatus        String?
  notes           String?
  metadataJson    Json?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([templateId, createdAt])
}

model BillingCatalogOverride {
  id                  String    @id @default(cuid())
  key                 String    @unique
  kind                String
  code                String
  interval            String?
  lookupKey           String?
  stripeProductId     String?
  stripePriceId       String?
  expectedAmountCents Int?
  currency            String?
  active              Boolean   @default(true)
  state               String    @default("draft")
  createdByUserId     String?
  updatedByUserId     String?
  lastVerifiedAt      DateTime?
  verificationStatus  String?
  verificationMessage String?
  changeNotes         String?
  metadataJson        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([kind, code])
  @@index([kind, code, interval])
  @@index([state, active])
  @@index([updatedAt])
}

model BillingCatalogOverrideHistory {
