model TradeAccount {
  id                     String                 @id @default(cuid())
  companyId              String
  name                   String
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  contactMobile          String?
  secondaryContactName   String?
  secondaryContactEmail  String?
  secondaryContactPhone  String?
  secondaryContactMobile String?
  vatNumber              String?
  companyNumber          String?
  paymentTermsDays       Int?
  portalEnabled          Boolean                @default(false)
  allowedServiceIdsJson  Json?
  allowedLocationIdsJson Json?
  businessAddressLine1   String?
  businessAddressLine2   String?
  businessCity           String?
  businessPostcode       String?
  businessCountry        String?
  billingContactName     String?
  billingEmail           String?
  billingPhone           String?
  billingMobile          String?
  billingAddressLine1    String?
  billingAddressLine2    String?
  billingCity            String?
  billingPostcode        String?
  billingCountry         String?
  creditLimit            Decimal                @db.Decimal(14, 2)
  outstandingBalance     Decimal                @default(0) @db.Decimal(14, 2)
  status                 TradeAccountStatus     @default(ACTIVE)
  nextActionType         NextActionType?
  nextActionDueAt        DateTime?
  nextActionUserId       String?
  lastContactedAt        DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  company                Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes                  TradeAccountNote[]
  locations              TradeAccountLocation[]
  contacts               TradeAccountContact[]
  portalAccesses         TradePortalAccess[]
  statements             AccountStatement[]
  jobs                   Job[]
  bookings               Booking[]
  customerTags           CustomerTag[]
  crmNotes               CRMNote[]
  crmTasks               CRMTask[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model TradeAccountLocation {
  id               String                   @id @default(cuid())
  companyId        String
  tradeAccountId   String
  linkedLocationId String?
  name             String
  kind             TradeAccountLocationKind @default(BUSINESS)
  legacyAliasKey   String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  postcode         String?
  country          String?
  isPrimary        Boolean                  @default(false)
  isBilling        Boolean                  @default(false)
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tradeAccount     TradeAccount             @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  linkedLocation   Location?                @relation(fields: [linkedLocationId], references: [id], onDelete: SetNull)
  contacts         TradeAccountContact[]

  @@unique([tradeAccountId, legacyAliasKey])
  @@index([companyId, tradeAccountId, createdAt])
  @@index([companyId, linkedLocationId])
}

model TradeAccountContact {
  id                     String                          @id @default(cuid())
  companyId              String
  tradeAccountId         String
  tradeAccountLocationId String?
  legacyAliasKey         String?
  name                   String
  roleLabel              String?
  email                  String?
  phone                  String?
  mobile                 String?
  isPrimary              Boolean                         @default(false)
  isBilling              Boolean                         @default(false)
  isActive               Boolean                         @default(true)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tradeAccount           TradeAccount                    @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  location               TradeAccountLocation?           @relation(fields: [tradeAccountLocationId], references: [id], onDelete: SetNull)
  preferences            TradeAccountContactPreference[]
  portalAccesses         TradePortalAccess[]

  @@unique([tradeAccountId, legacyAliasKey])
  @@index([companyId, tradeAccountId, createdAt])
  @@index([companyId, tradeAccountLocationId])
}

model TradeAccountContactPreference {
  id        String                               @id @default(cuid())
  companyId String
  contactId String
  event     TradeAccountContactPreferenceEvent
  channel   TradeAccountContactPreferenceChannel
  enabled   Boolean                              @default(true)
  createdAt DateTime                             @default(now())
  updatedAt DateTime                             @updatedAt
  company   Company                              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   TradeAccountContact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, event, channel])
  @@index([companyId, event, channel])
}

model Customer {
  id                        String                     @id @default(cuid())
  companyId                 String
  homeLocationId            String?
  slug                      String?
  name                      String
  email                     String?
  phone                     String?
  paymentTermsDays          Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeLocation              Location?                  @relation("CustomerHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)
  jobs                      Job[]
  activityEvents            ActivityEvent[]
  servicePlans              ServicePlan[]
  servicePlanRenewals       ServicePlanRenewal[]
  servicePlanChangeRequests ServicePlanChangeRequest[]
  customerAccount           CustomerAccount?
  approvals                 CustomerApproval[]
  quotes                    Quote[]
  revenueCollectionTasks    RevenueCollectionTask[]
  customerPaymentRequests   CustomerPaymentRequest[]
  statements                AccountStatement[]

  @@unique([companyId, slug])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, createdAt])
  @@index([companyId, homeLocationId, createdAt])
}

model CustomerAccount {
  id                   String                @id @default(cuid())
  tenantId             String
  customerId           String                @unique
  email                String
  passwordHash         String?
  status               CustomerAccountStatus @default(INVITED)
  lastLoginAt          DateTime?
  invitedAt            DateTime?
  activatedAt          DateTime?
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, invitedAt])
}

model CustomerApproval {
  id                String                     @id @default(cuid())
  tenantId          String
  customerId        String
  entityType        CustomerApprovalEntityType
  entityId          String
  kind              CustomerApprovalKind
  status            CustomerApprovalStatus     @default(PENDING)
  requestedAt       DateTime                   @default(now())
  respondedAt       DateTime?
  responseNote      String?
  requestedByUserId String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            Company                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
