model User {
  id                             String                        @id @default(cuid())
  companyId                      String
  email                          String
  emailVerified                  Boolean                       @default(false)
  passwordHash                   String
  role                           UserRole                      @default(STAFF)
  tokenVersion                   Int                           @default(0)
  isActive                       Boolean                       @default(true)
  color                          String?
  onlyMyLocation                 Boolean                       @default(false)
  defaultLocationId              String?
  createdAt                      DateTime                      @default(now())
  lastActiveAt                   DateTime?
  lastLoginAt                    DateTime?
  company                        Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultLocation                Location?                     @relation("UserDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  defaultAssignedLocations       Location[]                    @relation("LocationDefaultAssignee")
  locationAssignments            LocationStaffAssignment[]
  locationMemberships            LocationMembership[]
  assignedWorkflowSlaEvents      WorkflowSlaEvent[]            @relation("WorkflowSlaAssignedUser")
  assignedComplianceExceptions   ComplianceException[]         @relation("ComplianceExceptionAssignee")
  savedCommandViews              SavedCommandView[]
  savedBoardViews                SavedBoardView[]
  undoActions                    UserUndoAction[]
  assignedBookings               Booking[]                     @relation("BookingAssignee")
  assignedJobs                   Job[]                         @relation("JobAssignee")
  auditEvents                    AuditEvent[]                  @relation("AuditActor")
  createdJobAllowanceOverrides   TenantJobAllowanceOverride[]  @relation("TenantJobAllowanceOverrideCreator")
  createdJobAllowanceCredits     TenantJobAllowanceCredit[]    @relation("TenantJobAllowanceCreditCreator")
  aiChatAudits                   AiChatAudit[]                 @relation("AiAuditActor")
  jobDrafts                      JobDraft[]
  crmDrafts                      CrmDraft[]
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  jobActivities                  JobActivity[]                 @relation("JobActivityActor")
  crmNotes                       CRMNote[]                     @relation("CRMNoteAuthor")
  crmTasks                       CRMTask[]                     @relation("CRMTaskAssignee")
  staffAvailabilities            StaffAvailability[]
  notifications                  Notification[]
  notificationPreference         NotificationPreference?
  createdJobs                    Job[]                         @relation("JobCreator")
  technicianAvailabilities       TechnicianAvailability[]      @relation("TechnicianAvailabilityUser")
  technicianCapacityExceptions   TechnicianCapacityException[] @relation("TechnicianCapacityExceptionUser")
  technicianStockAssignments     TechnicianStockAssignment[]
  requestedCustomerApprovals     CustomerApproval[]            @relation("CustomerApprovalRequester")
  createdQuotes                  Quote[]                       @relation("QuoteCreator")
  jobExecutionRecords            JobExecutionRecord[]          @relation("JobExecutionTechnician")
  createdJobExecutionEvidence    JobExecutionEvidence[]        @relation("JobExecutionEvidenceCreator")
  issuedJobCompletionQuickLinks  JobCompletionQuickLink[]      @relation("JobCompletionQuickLinkIssuer")
  createdComplianceExceptions    ComplianceException[]         @relation("ComplianceExceptionCreator")
  resolvedComplianceExceptions   ComplianceException[]         @relation("ComplianceExceptionResolver")
  performanceScorecards          PerformanceScorecard[]
  compensationRuns               CompensationRun[]
  integrationConnections         IntegrationConnection[]       @relation("UserIntegrationConnections")
  integrationAuthStates          IntegrationAuthState[]        @relation("UserIntegrationAuthStates")
  personalIntegrationCredentials IntegrationCredential[]       @relation("UserPersonalIntegrationCredentials")
  createdIntegrationCredentials  IntegrationCredential[]       @relation("UserCreatedIntegrationCredentials")
  updatedIntegrationCredentials  IntegrationCredential[]       @relation("UserUpdatedIntegrationCredentials")
  platformSupportSessions        PlatformSupportSession[]      @relation("PlatformSupportSessionUser")
  submittedMarketingReviews      MarketingReview[]             @relation("MarketingReviewSubmitter")

  @@unique([companyId, email])
  @@index([companyId, role, isActive])
}

model Location {
  id                    String                    @id @default(cuid())
  companyId             String
  code                  String?
  name                  String
  kind                  LocationKind              @default(BRANCH)
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String?
  postalCode            String?
  country               String
  phone                 String?
  email                 String?
  isActive              Boolean                   @default(true)
  color                 String?
  timezone              String?
  metadataJson          Json?
  bookingLeadTimeMins   Int                       @default(0)
  defaultAssigneeId     String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultAssignee       User?                     @relation("LocationDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  jobs                  Job[]
  bookings              Booking[]
  businessHours         LocationBusinessHour[]
  staffAssignments      LocationStaffAssignment[]
  memberships           LocationMembership[]
  defaultUsers          User[]                    @relation("UserDefaultLocation")
  stockItems            StockItem[]
  stockPurchaseOrders   StockPurchaseOrder[]
  stockMovements        StockMovement[]
  inventoryLocations    InventoryLocation[]
  tenantSettingsDefault TenantSetting[]           @relation("TenantDefaultLocation")
  services              Service[]
  staffAvailabilities   StaffAvailability[]
  blackoutDates         BlackoutDate[]
  bookingQuestions      BookingQuestion[]
  savedBoardViews       SavedBoardView[]
  homeCustomers         Customer[]                @relation("CustomerHomeLocation")
  servicePlans          ServicePlan[]
  tradeAccountLocations TradeAccountLocation[]
  workflowSlaEvents     WorkflowSlaEvent[]
  complianceExceptions  ComplianceException[]
  performanceScorecards PerformanceScorecard[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, kind, isActive])
  @@index([companyId, defaultAssigneeId])
}

enum LocationKind {
  BRANCH
  WAREHOUSE
  SERVICE_REGION
  FRANCHISE
}

