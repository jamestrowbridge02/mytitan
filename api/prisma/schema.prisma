model StockItem {
  id               String                @id @default(cuid())
  tenantId         String
  locationId       String?
  description      String?
  category         String?
  sku              String
  name             String
  unit             String
  minLevel         Decimal               @default(0) @db.Decimal(14, 2)
  avgUnitCost      Decimal               @default(0) @db.Decimal(14, 2)
  unitPriceCents   Int                   @default(0)
  supplierId       String?
  isActive         Boolean               @default(true)
  metadataJson     Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location         Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier         StockSupplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poLines          StockPOLine[]
  movements        StockMovement[]
  jobLineItems     JobLineItem[]
  inventoryStocks  InventoryStock[]
  jobParts         JobPart[]
  supplierMappings SupplierItemMapping[]

  @@unique([tenantId, sku])
  @@index([tenantId, locationId])
  @@index([tenantId, supplierId])
  @@index([tenantId, createdAt])
}

model InventoryCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, active, name])
}

model StockSupplier {
  id                     String                @id @default(cuid())
  tenantId               String
  name                   String
  email                  String?
  phone                  String?
  capabilityMetadataJson Json?
  internalOnly           Boolean               @default(true)
  color                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  tenant                 Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders         StockPurchaseOrder[]
  stockItems             StockItem[]
  itemMappings           SupplierItemMapping[]

  @@index([tenantId, createdAt])
}

model ImportBatch {
  id              String    @id @default(cuid())
  companyId       String
  userId          String
  entityType      String
  mode            String    @default("CREATE")
  status          String    @default("VALIDATED")
  headersJson     Json
  mappingJson     Json
  rowsJson        Json
  validationJson  Json
  createdRefsJson Json?
  importedCount   Int       @default(0)
  failedCount     Int       @default(0)
  skippedCount    Int       @default(0)
  committedAt     DateTime?
  rolledBackAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
}

model SupplierItemMapping {
  id                String         @id @default(cuid())
  tenantId          String
  stockItemId       String
  supplierId        String?
  supplierName      String?
  supplierSku       String
  supplierReference String?
  preferred         Boolean        @default(false)
  active            Boolean        @default(true)
  metadataJson      Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Company        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockItem         StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  supplier          StockSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, stockItemId, supplierSku])
  @@index([tenantId, stockItemId, preferred])
  @@index([tenantId, supplierId, active])
}

model StockPurchaseOrder {
  id                   String                   @id @default(cuid())
  tenantId             String
  locationId           String?
  inventoryLocationId  String?
  supplierId           String?
  supplierName         String?
  status               StockPurchaseOrderStatus @default(DRAFT)
  createdByUserId      String?
  approvedByUserId     String?
  receivedByUserId     String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  cancelledAt          DateTime?
  orderedAt            DateTime?
  receivedAt           DateTime?
  notesJson            Json?
  supplierSnapshotJson Json?
  internalOnly         Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tenant               Company                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location             Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  inventoryLocation    InventoryLocation?       @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  supplier             StockSupplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines                StockPOLine[]

  @@index([tenantId, createdAt])
  @@index([tenantId, locationId])
  @@index([tenantId, inventoryLocationId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, approvedByUserId])
}

model StockPOLine {
  id                  String             @id @default(cuid())
  poId                String
  stockItemId         String
  sourceJobId         String?
  qtyOrdered          Decimal            @db.Decimal(14, 2)
  qtyReceived         Decimal            @default(0) @db.Decimal(14, 2)
  unitCost            Decimal            @default(0) @db.Decimal(14, 2)
  supplierSku         String?
  supplierReference   String?
  pricingSnapshotJson Json?
  notesJson           Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  po                  StockPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  stockItem           StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([poId, createdAt])
  @@index([stockItemId])
  @@index([sourceJobId])
}

model StockMovement {
  id                      String             @id @default(cuid())
  tenantId                String
  locationId              String?
  inventoryLocationId     String?
  fromInventoryLocationId String?
  toInventoryLocationId   String?
  stockItemId             String
  type                    StockMovementType
  qty                     Decimal            @db.Decimal(14, 2)
  reason                  String?
  jobId                   String?
  createdAt               DateTime           @default(now())
  tenant                  Company            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location                Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  inventoryLocation       InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  fromInventoryLocation   InventoryLocation? @relation("StockMovementFromLocation", fields: [fromInventoryLocationId], references: [id], onDelete: SetNull)
  toInventoryLocation     InventoryLocation? @relation("StockMovementToLocation", fields: [toInventoryLocationId], references: [id], onDelete: SetNull)
  stockItem               StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  job                     Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([tenantId, stockItemId, createdAt])
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, inventoryLocationId, createdAt])
  @@index([tenantId, fromInventoryLocationId, createdAt])
  @@index([tenantId, toInventoryLocationId, createdAt])
}

model InventoryLocation {
  id                    String                      @id @default(cuid())
  tenantId              String
  businessLocationId    String?
  name                  String
  kind                  InventoryLocationKind
  active                Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  tenant                Company                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessLocation      Location?                   @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)
  stocks                InventoryStock[]
  jobParts              JobPart[]
  purchaseOrders        StockPurchaseOrder[]
  stockMovements        StockMovement[]
  stockMovementsFrom    StockMovement[]             @relation("StockMovementFromLocation")
  stockMovementsTo      StockMovement[]             @relation("StockMovementToLocation")
  technicianAssignments TechnicianStockAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId, kind, active])
  @@index([tenantId, businessLocationId, active])
}

model TechnicianStockAssignment {
  id                  String            @id @default(cuid())
  tenantId            String
  technicianId        String
  inventoryLocationId String
  active              Boolean           @default(true)
  assignedAt          DateTime          @default(now())
  releasedAt          DateTime?
  notesJson           Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  technician          User              @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, technicianId, inventoryLocationId])
  @@index([tenantId, technicianId, active])
  @@index([tenantId, inventoryLocationId, active])
}

model InventoryStock {
  id                  String            @id @default(cuid())
  tenantId            String
  stockItemId         String
  inventoryLocationId String
  quantityOnHand      Decimal           @default(0) @db.Decimal(14, 2)
  quantityReserved    Decimal           @default(0) @db.Decimal(14, 2)
  reorderPoint        Decimal           @default(0) @db.Decimal(14, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockItem           StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stockItemId, inventoryLocationId])
  @@index([tenantId, inventoryLocationId, updatedAt])
  @@index([tenantId, stockItemId, updatedAt])
}

model JobPart {
  id               String             @id @default(cuid())
  tenantId         String
  jobId            String
  stockItemId      String
  quantityPlanned  Decimal            @default(0) @db.Decimal(14, 2)
  quantityReserved Decimal            @default(0) @db.Decimal(14, 2)
  quantityUsed     Decimal            @default(0) @db.Decimal(14, 2)
  unitCostCents    Int                @default(0)
  unitPriceCents   Int                @default(0)
  sourceLocationId String?
  status           JobPartStatus      @default(PLANNED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Company            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job              Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stockItem        StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  sourceLocation   InventoryLocation? @relation(fields: [sourceLocationId], references: [id], onDelete: SetNull)

  @@index([tenantId, jobId, status, createdAt])
  @@index([tenantId, stockItemId, status])
  @@index([tenantId, sourceLocationId, status])
}

model PasswordResetToken {
