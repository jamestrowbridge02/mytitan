  resolvedAt           DateTime?
  resolvedByUserId     String?
  clearable            Boolean   @default(true)
  validationOnly       Boolean   @default(false)
  auditProtected       Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([category, status, lastSeenAt])
  @@index([status, clearable, lastSeenAt])
  @@index([validationOnly, status, lastSeenAt])
}

model FormTemplate {
  id        String      @id @default(cuid())
  tradeCode String
