  overrideKey        String
  kind               String
  code               String
  interval           String?
  action             String
  changeNotes        String?
  previousValuesJson Json?
  nextValuesJson     Json?
  metadataJson       Json?
  createdByUserId    String?
  createdAt          DateTime @default(now())

  @@index([overrideKey, createdAt])
  @@index([kind, code, createdAt])
}

model PlatformSafeErrorLog {
  id                   String    @id @default(cuid())
  category             String
  area                 String
  summary              String
  sanitizedDetailsJson Json?
  sourceKind           String?
  sourceRef            String?
