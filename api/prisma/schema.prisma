  updatedAt                      DateTime                        @updatedAt
  users                          User[]
  locations                      Location[]
  tradeAccounts                  TradeAccount[]
  jobs                           Job[]
  bookings                       Booking[]
  bookingServiceLines            BookingServiceLine[]
  bookingBusinessHours           BookingBusinessHour[]
  bookingBlackoutDates           BookingBlackoutDate[]
  auditEvents                    AuditEvent[]
  invoiceCounter                 InvoiceCounter[]
  tenantSetting                  TenantSetting?
  catalogItems                   ServiceCatalogItem[]
  emailTemplates                 EmailTemplate[]
  aiChatAudits                   AiChatAudit[]
  subscriptions                  TenantSubscription?
  usageMeters                    UsageMeter[]
  jobCompletionPackPurchases     JobCompletionPackPurchase[]
  jobAllowanceOverride           TenantJobAllowanceOverride?
  jobAllowanceCredits            TenantJobAllowanceCredit[]
  inviteTokens                   InviteToken[]
  integrationConnections         IntegrationConnection[]
  integrationAuthStates          IntegrationAuthState[]
  integrationCredentials         IntegrationCredential[]
  integrationWebhookReceipts     IntegrationWebhookReceipt[]
  assets                         Asset[]
  financialApprovalPolicies      FinancialApprovalPolicy[]
  financialApprovalRequests      FinancialApprovalRequest[]
  vehicleLookupAudits            VehicleLookupAudit[]
  apiTokens                      ApiToken[]
  webhookEndpoints               WebhookEndpoint[]
  webhookDeliveries              WebhookDelivery[]
  documentArtifacts              DocumentArtifact[]
  servicePlans                   ServicePlan[]
  servicePlanRuns                ServicePlanRun[]
  servicePlanRenewals            ServicePlanRenewal[]
  servicePlanChangeRequests      ServicePlanChangeRequest[]
  quotes                         Quote[]
  revenueCollectionTasks         RevenueCollectionTask[]
  tradePackInstalls              TradePackInstall[]
  templatePresets                TemplatePreset[]
  tradeAccountNotes              TradeAccountNote[]
  tradeAccountLocations          TradeAccountLocation[]
  tradeAccountContacts           TradeAccountContact[]
  tradeAccountContactPreferences TradeAccountContactPreference[]
  jobDrafts                      JobDraft[]
  crmDrafts                      CrmDraft[]
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  savedCommandViews              SavedCommandView[]
  userUndoActions                UserUndoAction[]
  locationBusinessHours          LocationBusinessHour[]
  locationStaffAssignments       LocationStaffAssignment[]
  locationMemberships            LocationMembership[]
  workflowSlaPolicies            WorkflowSlaPolicy[]
  workflowSlaEvents              WorkflowSlaEvent[]
  complianceExceptions           ComplianceException[]
  performancePeriods             PerformancePeriod[]
  performanceScorecards          PerformanceScorecard[]
  compensationRules              CompensationRule[]
  compensationRuns               CompensationRun[]
  jobLineItems                   JobLineItem[]
  stockItems                     StockItem[]
  stockSuppliers                 StockSupplier[]
  inventoryCategories            InventoryCategory[]
  supplierItemMappings           SupplierItemMapping[]
  stockPurchaseOrders            StockPurchaseOrder[]
  stockMovements                 StockMovement[]
  inventoryLocations             InventoryLocation[]
  inventoryStocks                InventoryStock[]
  technicianStockAssignments     TechnicianStockAssignment[]
  jobParts                       JobPart[]
  jobActivities                  JobActivity[]
  jobTags                        JobTag[]
  savedBoardViews                SavedBoardView[]
  jobReminders                   JobReminder[]
  services                       Service[]
  staffAvailabilities            StaffAvailability[]
  techScheduleSettings           TechScheduleSetting[]
  techScheduleExceptions         TechScheduleException[]
  technicianAvailabilities       TechnicianAvailability[]
  technicianCapacityExceptions   TechnicianCapacityException[]
  blackoutDates                  BlackoutDate[]
  bookingQuestions               BookingQuestion[]
  bookingAnswers                 BookingAnswer[]
  customerTags                   CustomerTag[]
  customerSegments               CustomerSegment[]
  customers                      Customer[]
  crmNotes                       CRMNote[]
  crmTasks                       CRMTask[]
  notifications                  Notification[]
  notificationPreferences        NotificationPreference[]
  websiteVisitEvents             WebsiteVisitEvent[]
  customerPaymentRequests        CustomerPaymentRequest[]
  enterpriseFeatureFlags         EnterpriseFeatureFlag[]
  jobSignatures                  JobSignature[]
  automationsSetting             AutomationsSetting?
  automationRules                AutomationRule[]
  automationSuggestionStates     AutomationSuggestionState[]
  customFields                   CustomField[]
  customFieldValues              CustomFieldValue[]
  customerAccounts               CustomerAccount[]
  customerApprovals              CustomerApproval[]
  jobExecutionRecords            JobExecutionRecord[]
  jobExecutionEvidence           JobExecutionEvidence[]
  jobCompletionQuickLinks        JobCompletionQuickLink[]
  platformSupportSessions        PlatformSupportSession[]
  importBatches                  ImportBatch[]
  marketingReviews               MarketingReview[]
  accountStatements              AccountStatement[]
  tradePortalAccesses            TradePortalAccess[]
  tradeApplicationSetting        TradeAccountApplicationSetting?
  tradeAccountApplications       TradeAccountApplication[]
  documentSequences              DocumentSequence[]
  archivePeriods                 ArchivePeriod[]
