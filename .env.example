POSTGRES_PASSWORD=replace_with_secure_password
JWT_SECRET=replace_with_long_random_secret
APP_PUBLIC_URL=https://app.mytitan.co.uk
API_PUBLIC_URL=https://api.mytitan.co.uk
CORS_ALLOWED_ORIGINS=https://app.mytitan.co.uk,https://mytitan.co.uk,https://www.mytitan.co.uk

# App/API origin contract
# Standard Docker deploys should keep browser calls same-origin and proxy them through the app server.
MYTITAN_API_PROXY_TARGET=http://api:3000
# Standalone Next.js dev can still point directly at a local API if needed.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

MYTITAN_FEATURE_MARKETPLACE=off
NEXT_PUBLIC_MYTITAN_FEATURE_MARKETPLACE=off
MYTITAN_FEATURE_START_HERE=off
