# OpenAI (server-side only; never expose to browser)
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Stripe billing
# Recommended for MyTitan: a restricted live key for the backend with only the Stripe capabilities
# needed for customers, checkout sessions, subscriptions, invoices, payment intents, prices, and the billing portal.
# A standard secret key also works, but a publishable key must never be placed in STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=replace_with_stripe_secret_or_restricted_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
# Stripe Connect uses a separate endpoint configured for events from connected accounts:
# API_PUBLIC_URL/billing/customer-payments/stripe-connect/webhook
STRIPE_CONNECT_PLATFORM_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Keep dry_run until the Connect platform, endpoint, and controlled payment canary are verified.
MYTITAN_TENANT_STRIPE_CONNECT_MODE=dry_run
MYTITAN_FLAG_TENANT_PAYMENTS_BYOG_V1=0
# MyTitan does not currently require a Stripe publishable key because checkout and portal redirects are created server-side.
# Leave this unset unless the app is later updated to use Stripe.js on the frontend.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SOLE_TRADER_MONTHLY=price_123
STRIPE_PRICE_SOLE_TRADER_ANNUAL=price_124
STRIPE_PRICE_BUSINESS_MONTHLY=price_223
STRIPE_PRICE_BUSINESS_ANNUAL=price_224
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_323
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_324
# Optional job-pack fallback mapping.
# Prefer Stripe lookup_key first, then metadata. Use these only when the live Stripe objects
# already exist but were created without the expected lookup_key or metadata contract.
STRIPE_JOB_COMPLETION_PACK_CURRENCY=GBP
STRIPE_JOB_COMPLETION_PACK_1_PRICE_ID=
STRIPE_JOB_COMPLETION_PACK_1_PRODUCT_ID=
STRIPE_JOB_COMPLETION_PACK_2_PRICE_ID=
STRIPE_JOB_COMPLETION_PACK_2_PRODUCT_ID=
STRIPE_JOB_COMPLETION_PACK_3_PRICE_ID=
STRIPE_JOB_COMPLETION_PACK_3_PRODUCT_ID=
STRIPE_JOB_COMPLETION_PACK_4_PRICE_ID=
STRIPE_JOB_COMPLETION_PACK_4_PRODUCT_ID=
# No Stripe portal configuration ID or product ID envs are currently required by MyTitan.
STRIPE_BILLING_RETURN_URL=https://app.mytitan.co.uk/dashboard/billing

# Integrations encryption
INTEGRATIONS_ENCRYPTION_KEY=

# OAuth (placeholders)
XERO_CLIENT_ID=replace_with_xero_client_id
XERO_CLIENT_SECRET=replace_with_xero_client_secret
XERO_REDIRECT_URL=https://api.mytitan.co.uk/integrations/xero/callback
QBO_CLIENT_ID=replace_with_qbo_client_id
QBO_CLIENT_SECRET=replace_with_qbo_client_secret
QBO_REDIRECT_URL=https://api.mytitan.co.uk/integrations/qbo/callback
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_OAUTH_REDIRECT_URL=https://api.mytitan.co.uk/integrations/google/callback

# SMTP / outbound email (optional, server-side only)
# MyTitan system email prefers SMTP_HOST, SMTP_FROM_EMAIL, SMTP_FROM_NAME,
# and matching credentials when the provider requires authentication.
# Legacy server-side aliases still accepted:
# SMTP_PASS, SMTP_FROM, MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASSWORD,
# MAIL_FROM, EMAIL_FROM, FROM_EMAIL, SYSTEM_EMAIL, MAIL_FROM_NAME,
# EMAIL_FROM_NAME, SYSTEM_EMAIL_NAME
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
REPLY_TO_EMAIL=

# Upload limits
TENANT_LOGO_MAX_BYTES=2097152

# Public booking abuse protection
PUBLIC_BOOKING_SLOTS_RATE_LIMIT=600
PUBLIC_BOOKING_SLOTS_RATE_WINDOW_MS=60000
PUBLIC_BOOKING_CREATE_RATE_LIMIT=25
PUBLIC_BOOKING_CREATE_RATE_WINDOW_MS=60000
PUBLIC_BOOKING_STATUS_RATE_LIMIT=300
PUBLIC_BOOKING_STATUS_RATE_WINDOW_MS=60000
PUBLIC_BOOKING_STATUS_SLOTS_RATE_LIMIT=600
PUBLIC_BOOKING_STATUS_SLOTS_RATE_WINDOW_MS=60000
PUBLIC_BOOKING_RESCHEDULE_RATE_LIMIT=20
PUBLIC_BOOKING_RESCHEDULE_RATE_WINDOW_MS=60000
PUBLIC_BOOKING_CANCEL_RATE_LIMIT=20
PUBLIC_BOOKING_CANCEL_RATE_WINDOW_MS=60000
PUBLIC_BOOKING_DEPOSIT_RATE_LIMIT=15
PUBLIC_BOOKING_DEPOSIT_RATE_WINDOW_MS=60000

# Backups (host)
BACKUP_ENCRYPTION_KEY=replace_with_strong_passphrase
