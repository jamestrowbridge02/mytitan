MYTITAN_FEATURE_NOTIFICATIONS_V1=on
NEXT_PUBLIC_MYTITAN_FEATURE_NOTIFICATIONS_V1=on
MYTITAN_FEATURE_CALENDAR_V2_DRAG=on
NEXT_PUBLIC_MYTITAN_FEATURE_CALENDAR_V2_DRAG=on
